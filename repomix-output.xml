import { describe, expect, it } from "vitest";
import { CSV_HEADER, MemorySink, SourceRecordSchema, checkAdapterContract, runAdapter, toCsvRow } from "@leads/core";
// @ts-ignore untyped JS module from the scraper patch
import { mapPlace as jsMap, toCsv as jsCsv } from "../scraper/persist.js";
import { createGmapsLegacy, mapPlace } from "./index";

const places = [
  { place_id: "a", name: 'Glow, "Med" Spa', formatted_address: "1 Main St", international_phone_number: "+1 614-555-0101", website: "https://glow.com", rating: 4.8, user_ratings_total: 120, business_status: "OPERATIONAL", url: "https://maps/a", geometry: { location: { lat: 39.9, lng: -83 } }, fallback_data: { emails: ["x@glow.com"], phones: ["614-555-0101"], social_media: ["https://instagram.com/glow"] } },
  { place_id: "b", name: "No Site Clinic", formatted_address: "2 Oak Ave", geometry: { location: { lat: 1, lng: 2 } } },
];
const fakeFetch = (async () => ({ ok: true, status: 200, json: async () => ({ results: places }), text: async () => "" })) as unknown as typeof fetch;

describe("gmaps legacy adapter", () => {
  const adapter = createGmapsLegacy({ baseUrl: "http://x", fetchImpl: fakeFetch });
  it("passes the adapter contract", async () => { expect(await checkAdapterContract(adapter, { city: "Columbus, OH", keyword: "med spa" })).toEqual([]); });
  it("flows through the runner", async () => {
    const sink = new MemorySink();
    const s = await runAdapter(adapter, { city: "c", keyword: "med spa" }, { runId: "g1", sinks: [sink] });
    expect(s.records).toBe(2); expect(sink.records[1]!.signals.some((x) => x.type === "no_website")).toBe(true);
  });
  it("surfaces scraper HTTP errors", async () => {
    const bad = createGmapsLegacy({ baseUrl: "http://x", fetchImpl: (async () => ({ ok: false, status: 429, text: async () => "busy" })) as unknown as typeof fetch });
    const s = await runAdapter(bad, { city: "c", keyword: "k" }, { runId: "g2" });
    expect(s.status).toBe("failed"); expect(s.error).toContain("429");
  });
});
describe("TS and JS mappers stay in parity", () => {
  it("same records and same CSV", () => {
    const ts = places.map((p) => mapPlace(p, "med spa")), js = places.map((p: any) => jsMap(p, "med spa"));
    expect(JSON.parse(JSON.stringify(ts))).toEqual(JSON.parse(JSON.stringify(js)));
    const csv = CSV_HEADER.join(",") + "\n" + ts.map((r) => toCsvRow(SourceRecordSchema.parse(r)) + "\n").join("");
    expect(jsCsv(js)).toBe(csv);
  });
});
