<file path="apps/web/lib/runner.ts">
import { Budget, runAdapter, type RunStore as CoreRunStore, type Sink } from "@leads/core";
import { createGmapsLegacy } from "@leads/source-gmaps";
import { config, isGmapsConfigured } from "./config";
import { getStore } from "./store";
import type { LeadStore, NormalizedRecord } from "./store/types";

export interface GmapsRunInput { city: string; keyword: string; radius?: number; areas?: string[] }

function asCoreRunStore(store: LeadStore): CoreRunStore {
  return {
    async start(runId) { await store.updateRun(runId, { status: "running", startedAt: new Date().toISOString(), heartbeatAt: new Date().toISOString() }); },
    async progress(runId, p) { await store.updateRun(runId, { records: p.records, spend: p.spend, heartbeatAt: new Date().toISOString() }); },
    async finish(summary) {
      await store.updateRun(summary.runId, {
        status: summary.status, records: summary.records, spend: summary.spend,
        error: summary.error ?? null, finishedAt: new Date().toISOString(),
      });
    },
    async isCancelRequested(runId) { return Boolean((await store.getRun(runId))?.cancelRequested); },
  };
}
function asSink(store: LeadStore, runId: string): Sink {
  return { async write(records) { await store.appendRecords(runId, records as NormalizedRecord[]); }, async close() {} };
}

/** Runs in the current Node process (not a serverless/edge function) -- see README "Known limits". */
const inFlight = new Set<string>();
export const isRunInFlight = (id: string) => inFlight.has(id);

export async function startGmapsRun(input: GmapsRunInput) {
  const store = getStore();
  const row = await store.createRun({ source: "gmaps", input });

  if (!isGmapsConfigured()) {
    await store.updateRun(row.id, { status: "failed", error: "GMAPS_SERVICE_URL is not set. Add it in .env.local (see Settings)." });
    return row;
  }
  const adapter = createGmapsLegacy({ baseUrl: config.gmapsServiceUrl, token: config.gmapsServiceToken || undefined });
  inFlight.add(row.id);
  runAdapter(adapter, input, {
    runId: row.id,
    budget: new Budget(),
    store: asCoreRunStore(store),
    sinks: [asSink(store, row.id)],
    log: (m, d) => console.log(`[run ${row.id}] ${m}`, d ?? ""),
  })
    .catch((e) => console.error(`[run ${row.id}] crashed`, e))
    .finally(() => inFlight.delete(row.id));

  return row;
}
</file>

<file path="apps/web/lib/store/file-store.ts">
import { mkdir, readFile, writeFile, appendFile } from "node:fs/promises";
import { existsSync } from "node:fs";
import { randomUUID } from "node:crypto";
import { dirname, join } from "node:path";
import type { LeadStore, NormalizedRecord, RunRow } from "./types";

/**
 * Local, zero-config backend. Data lives under apps/web/.data/ as plain JSON/JSONL files.
 * Writes are serialized per file with a tiny in-process mutex -- correct for a single Node
 * process (next dev / next start), not for multiple instances. That's the explicit trade for
 * running with no database until Supabase is wired up (see README "Known limits").
 */
const DATA_DIR = join(process.cwd(), ".data");
const RUNS_FILE = join(DATA_DIR, "runs.json");
const recordsFile = (runId: string) => join(DATA_DIR, "records", `${runId}.jsonl`);

const locks = new Map<string, Promise<unknown>>();
function withLock<T>(key: string, fn: () => Promise<T>): Promise<T> {
  const prev = locks.get(key) ?? Promise.resolve();
  const next = prev.then(fn, fn);
  locks.set(key, next.then(() => undefined, () => undefined));
  return next;
}

async function readRuns(): Promise<Record<string, RunRow>> {
  if (!existsSync(RUNS_FILE)) return {};
  try { return JSON.parse(await readFile(RUNS_FILE, "utf8")); } catch { return {}; }
}
async function writeRuns(runs: Record<string, RunRow>) {
  await mkdir(dirname(RUNS_FILE), { recursive: true });
  await writeFile(RUNS_FILE, JSON.stringify(runs, null, 2));
}

export class FileStore implements LeadStore {
  readonly backend = "file" as const;

  async createRun(row: { source: string; input: unknown }): Promise<RunRow> {
    return withLock("runs", async () => {
      const runs = await readRuns();
      const id = randomUUID();
      const r: RunRow = {
        id, source: row.source, input: row.input, status: "queued", records: 0, spend: {},
        error: null, artifacts: [], cancelRequested: false, createdAt: new Date().toISOString(),
        startedAt: null, finishedAt: null, heartbeatAt: null,
      };
      runs[id] = r;
      await writeRuns(runs);
      return r;
    });
  }
  async getRun(id: string) { return (await readRuns())[id] ?? null; }
  async listRuns(limit = 100) {
    const runs = Object.values(await readRuns());
    return runs.sort((a, b) => b.createdAt.localeCompare(a.createdAt)).slice(0, limit);
  }
  async updateRun(id: string, patch: Partial<RunRow>) {
    return withLock("runs", async () => {
      const runs = await readRuns();
      if (!runs[id]) return;
      runs[id] = { ...runs[id], ...patch };
      await writeRuns(runs);
    });
  }
  async appendRecords(runId: string, records: NormalizedRecord[]) {
    if (!records.length) return;
    const path = recordsFile(runId);
    return withLock(path, async () => {
      await mkdir(dirname(path), { recursive: true });
      await appendFile(path, records.map((r) => JSON.stringify(r)).join("\n") + "\n");
    });
  }
  async listRecords(runId: string, limit = 5000) {
    const path = recordsFile(runId);
    if (!existsSync(path)) return [];
    const text = await readFile(path, "utf8");
    const lines = text.split("\n").filter(Boolean);
    return lines.slice(0, limit).map((l) => JSON.parse(l) as NormalizedRecord);
  }
  async listAllRecords(limit = 2000) {
    const runs = await this.listRuns(500);
    const out: NormalizedRecord[] = [];
    for (const r of runs) {
      if (out.length >= limit) break;
      out.push(...(await this.listRecords(r.id, limit - out.length)));
    }
    return out;
  }
  async requestCancel(id: string) { await this.updateRun(id, { cancelRequested: true }); }
}
</file>

