        <div className="card"><div className="kpi-label">Leads (recent runs)</div><div className="kpi-value">{totalLeads}</div></div>
        <div className="card"><div className="kpi-label">GMaps service</div><div className="kpi-value"><StatusBadge status={isGmapsConfigured() ? "active" : "failed"} /></div></div>
        <div className="card"><div className="kpi-label">Storage backend</div><div className="kpi-value"><StatusBadge status={isSupabaseConfigured() ? "active" : "planned"} /> <span className="text-sm font-normal ml-1">{store.backend}</span></div></div>
      </div>

      <div className="card">
        <div className="flex items-center justify-between mb-3">
          <b className="text-sm">Recent runs</b>
          <Link href="/runs" className="text-sm" style={{ color: "var(--accent)" }}>View all →</Link>
        </div>
        {runs.length === 0 ? (
          <p className="text-sm" style={{ color: "var(--muted)" }}>No runs yet. Start one from Sources → GMaps.</p>
        ) : (
          <table className="data">
            <thead><tr><th>Run</th><th>Source</th><th>Status</th><th>Records</th><th>Spend</th><th>Started</th></tr></thead>
            <tbody>
              {runs.map((r) => (
                <tr key={r.id}>
                  <td><Link href={`/runs/${r.id}`} style={{ color: "var(--accent)" }}>{r.id.slice(0, 8)}</Link></td>
                  <td>{r.source}</td>
                  <td><StatusBadge status={r.status} /></td>
                  <td>{r.records}</td>
                  <td>{money(r.spend)}</td>
                  <td>{relativeTime(r.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  );
}
