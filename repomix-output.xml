"use client";
import { useEffect, useState } from "react";
import Link from "next/link";
import { StatusBadge } from "@/components/badge";
import { relativeTime } from "@/lib/format";

interface RunRow { id: string; status: string; records: number; error?: string | null; createdAt: string; input: any }

export function GmapsClient({ gmapsConfigured }: { gmapsConfigured: boolean }) {
  const [city, setCity] = useState("Columbus, OH");
  const [keyword, setKeyword] = useState("med spa");
  const [radius, setRadius] = useState(3000);
  const [areas, setAreas] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [activeId, setActiveId] = useState<string | null>(null);
  const [runs, setRuns] = useState<RunRow[]>([]);
  const [error, setError] = useState<string | null>(null);

  const refresh = async () => {
    const res = await fetch("/api/runs?source=gmaps", { cache: "no-store" });
    const data = await res.json();
    setRuns(data.runs ?? []);
  };
  useEffect(() => { refresh(); }, []);
  useEffect(() => {
    const active = runs.find((r) => r.id === activeId);
    if (!active || active.status === "succeeded" || active.status === "failed" || active.status === "canceled") return;
    const t = setInterval(refresh, 2000);
    return () => clearInterval(t);
  }, [activeId, runs]);

  const active = runs.find((r) => r.id === activeId) ?? runs[0];

  async function submit() {
    setSubmitting(true); setError(null);
    try {
      const body = { source: "gmaps", input: { city, keyword, radius, areas: areas.split(",").map((a) => a.trim()).filter(Boolean) || undefined } };
      const res = await fetch("/api/runs", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? "Failed to start run");
      setActiveId(data.run.id);
      await refresh();
    } catch (e: any) { setError(e.message); } finally { setSubmitting(false); }
  }

  return (
    <div className="grid grid-cols-[1fr_1.4fr] gap-4">
      <div className="card space-y-3">
        <b>New run</b>
        <div>
          <label className="label">City, State</label>
          <input className="input" value={city} onChange={(e) => setCity(e.target.value)} placeholder="Columbus, OH" />
        </div>
        <div>
          <label className="label">Niche / keyword</label>
          <input className="input" value={keyword} onChange={(e) => setKeyword(e.target.value)} placeholder="med spa" />
        </div>
        <div>
          <label className="label">Radius (meters)</label>
          <input className="input" type="number" value={radius} onChange={(e) => setRadius(Number(e.target.value))} />
        </div>
        <div>
          <label className="label">Named areas (optional, comma-separated — skips grid search)</label>
          <input className="input" value={areas} onChange={(e) => setAreas(e.target.value)} placeholder="Short North, Clintonville" />
        </div>
        {!gmapsConfigured && (
          <p className="text-xs" style={{ color: "var(--warn)" }}>GMAPS_SERVICE_URL is not set — this run will start but fail immediately. See Settings.</p>
        )}
        {error && <p className="text-xs" style={{ color: "var(--danger)" }}>{error}</p>}
        <button className="btn" onClick={submit} disabled={submitting || !city || !keyword}>
          {submitting ? "Starting…" : "Start run"}
        </button>
      </div>

      <div className="space-y-4">
        {active ? (
          <div className="card">
            <div className="flex items-center justify-between">
              <b className="text-sm">Run {active.id.slice(0, 8)}</b>
              <StatusBadge status={active.status} />
            </div>
            <div className="grid grid-cols-2 gap-3 mt-3">
              <div className="card"><div className="kpi-label">Records</div><div className="kpi-value">{active.records}</div></div>
              <div className="card"><div className="kpi-label">Input</div><div className="text-xs mt-1" style={{ color: "var(--muted)" }}>{active.input?.city} · {active.input?.keyword}</div></div>
            </div>
            {active.error && <p className="text-xs mt-3" style={{ color: "var(--danger)" }}>{active.error}</p>}
            {active.status === "succeeded" && (
              <div className="mt-3 text-sm space-x-3">
                <a className="underline" style={{ color: "var(--accent)" }} href={`/api/runs/${active.id}/records?format=csv`}>Download CSV</a>
                <a className="underline" style={{ color: "var(--accent)" }} href={`/api/runs/${active.id}/records?format=jsonl`}>Download JSONL</a>
              </div>
            )}
            <Link href={`/runs/${active.id}`} className="text-xs mt-3 inline-block" style={{ color: "var(--accent)" }}>Open run detail →</Link>
          </div>
        ) : (
          <div className="card text-sm" style={{ color: "var(--muted)" }}>No runs yet for this source.</div>
        )}

        <div className="card">
          <b className="text-sm">Recent GMaps runs</b>
          <table className="data mt-2">
            <thead><tr><th>Run</th><th>Status</th><th>Records</th><th>Started</th></tr></thead>
            <tbody>
              {runs.map((r) => (
                <tr key={r.id} onClick={() => setActiveId(r.id)} style={{ cursor: "pointer" }}>
                  <td>{r.id.slice(0, 8)}</td>
                  <td><StatusBadge status={r.status} /></td>
                  <td>{r.records}</td>
                  <td>{relativeTime(r.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
