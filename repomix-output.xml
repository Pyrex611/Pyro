              <span className={`text-xs px-2.5 py-1 rounded-full font-medium ${moltsetsOk ? "bg-[#e6f2ee] text-[#0f6e56]" : "bg-gray-100 text-gray-500"}`}>
                {moltsetsOk ? "✓ MOLTSETS_API_KEY Active" : "Missing MOLTSETS_API_KEY"}
