<file path="apps/web/app/leads/leads-client.tsx">
"use client";
import { useEffect, useMemo, useState } from "react";

interface Entity {
  id: string; name?: string; phone?: string; domain?: string; address?: string;
  niche: string[]; members: { source: string; sourceId: string }[]; signals: { type: string; value: unknown }[];
}

export function LeadsClient() {
  const [entities, setEntities] = useState<Entity[]>([]);
  const [loading, setLoading] = useState(true);
  const [niche, setNiche] = useState("all");
  const [hasWebsite, setHasWebsite] = useState("any");
  const [q, setQ] = useState("");
  const [selected, setSelected] = useState<Entity | null>(null);

  useEffect(() => {
    fetch("/api/leads", { cache: "no-store" }).then((r) => r.json()).then((d) => { setEntities(d.entities ?? []); setLoading(false); });
  }, []);

  const niches = useMemo(() => ["all", ...Array.from(new Set(entities.flatMap((e) => e.niche)))], [entities]);
  const filtered = useMemo(() => entities.filter((e) => {
    if (niche !== "all" && !e.niche.includes(niche)) return false;
    if (hasWebsite === "yes" && !e.domain) return false;
    if (hasWebsite === "no" && e.domain) return false;
    if (q && !(e.name ?? "").toLowerCase().includes(q.toLowerCase())) return false;
    return true;
  }), [entities, niche, hasWebsite, q]);

  function exportCsv() {
    const header = ["name", "phone", "domain", "address", "niche", "sources"];
    const esc = (v: unknown) => { const s = v === undefined || v === null ? "" : String(v); return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; };
    const rows = filtered.map((e) => [e.name, e.phone, e.domain, e.address, e.niche.join("|"), e.members.map((m) => m.source).join("|")].map(esc).join(","));
    const blob = new Blob([header.join(",") + "\n" + rows.join("\n")], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a"); a.href = url; a.download = "leads.csv"; a.click(); URL.revokeObjectURL(url);
  }

  return (
    <div className="space-y-4">
      <div className="flex gap-2 flex-wrap items-center">
        <select className="select w-auto" value={niche} onChange={(e) => setNiche(e.target.value)}>
          {niches.map((n) => <option key={n} value={n}>{n === "all" ? "Niche: All" : n}</option>)}
        </select>
        <select className="select w-auto" value={hasWebsite} onChange={(e) => setHasWebsite(e.target.value)}>
          <option value="any">Has website: Any</option>
          <option value="yes">Has website: Yes</option>
          <option value="no">Has website: No</option>
        </select>
        <input className="input w-auto" placeholder="Search name…" value={q} onChange={(e) => setQ(e.target.value)} />
        <button className="btn-outline" onClick={exportCsv} disabled={!filtered.length}>Export CSV</button>
        <span className="text-xs ml-auto" style={{ color: "var(--muted)" }}>{filtered.length} of {entities.length} leads</span>
      </div>

      <div className="grid grid-cols-[2fr_1fr] gap-4">
        <div className="card">
          {loading ? (
            <p className="text-sm" style={{ color: "var(--muted)" }}>Loading…</p>
          ) : filtered.length === 0 ? (
            <p className="text-sm" style={{ color: "var(--muted)" }}>No leads yet. Run a source from Sources → GMaps.</p>
          ) : (
            <table className="data">
              <thead><tr><th>Business</th><th>Phone</th><th>Website</th><th>Niche</th><th>Sources</th></tr></thead>
              <tbody>
                {filtered.map((e) => (
                  <tr key={e.id} onClick={() => setSelected(e)} style={{ cursor: "pointer" }}>
                    <td>{e.name ?? "—"}</td><td>{e.phone ?? "—"}</td><td>{e.domain ?? "—"}</td>
                    <td>{e.niche.join(", ") || "—"}</td><td>{Array.from(new Set(e.members.map((m) => m.source))).join(", ")}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
        <div className="card">
          {selected ? (
            <>
              <b>{selected.name ?? "Unnamed lead"}</b>
              <p className="text-xs mt-2" style={{ color: "var(--muted)" }}>Signals</p>
              <ul className="text-sm mt-1 space-y-1">
                {selected.signals.length === 0 && <li style={{ color: "var(--muted)" }}>None recorded.</li>}
                {selected.signals.map((s, i) => <li key={i}>{s.type}: {typeof s.value === "object" ? JSON.stringify(s.value) : String(s.value)}</li>)}
              </ul>
              <p className="text-xs mt-3" style={{ color: "var(--muted)" }}>Provenance</p>
              <ul className="text-sm mt-1 space-y-1">
                {selected.members.map((m, i) => <li key={i}>{m.source} · {m.sourceId}</li>)}
              </ul>
            </>
          ) : (
            <p className="text-sm" style={{ color: "var(--muted)" }}>Select a lead to see signals and provenance.</p>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

