<file path="sources/gmaps/scraper/job.js">
/** Cloud Run Job entrypoint: `node job.js` with RUN_ID set. Loads input from the runs row, scrapes, persists, reports. */
import { pathToFileURL } from "node:url";
import { persistRun as defaultPersist } from "./persist.js";

const now = () => new Date().toISOString();

export async function runJob({ db, runId, scrape, persist = defaultPersist, pollMs = 15000, log = console.log }) {
  const { data: run, error } = await db.from("runs").select("input,status").eq("id", runId).single();
  if (error || !run) throw new Error(`run ${runId} not found: ${error?.message ?? "no row"}`);
  const upd = async (v) => { const r = await db.from("runs").update(v).eq("id", runId); if (r?.error) log("run update failed: " + r.error.message); };
  await upd({ status: "running", started_at: now(), heartbeat_at: now() });

  let cancelled = false, signalCancel;
  const cancelP = new Promise((res) => { signalCancel = res; });
  const timer = setInterval(async () => {
    try {
      await upd({ heartbeat_at: now() });
      const { data } = await db.from("runs").select("cancel_requested").eq("id", runId).single();
      if (data?.cancel_requested) { cancelled = true; signalCancel("cancelled"); }
    } catch (e) { log("poll error: " + e.message); }
  }, pollMs);

  try {
    const out = await Promise.race([scrape(run.input), cancelP]);
    if (cancelled) {
      await upd({ status: "canceled", error: "Canceled by user. Legacy mode keeps no partial results.", finished_at: now() });
      return "canceled";
    }
    const { records, artifacts } = await persist(db, { runId, input: run.input, results: out.results });
    await upd({ status: "succeeded", records, artifacts, error: null, finished_at: now() });
    return "succeeded";
  } catch (e) {
    await upd({ status: "failed", error: String(e?.message ?? e), artifacts: e?.artifacts ?? [], finished_at: now() });
    return "failed";
  } finally { clearInterval(timer); }
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const { RUN_ID, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY } = process.env;
  if (!RUN_ID || !SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) { console.error("RUN_ID, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are required"); process.exit(2); }
  const { createClient } = await import("@supabase/supabase-js");
  const { runScrape, log: fileLog } = await import("./scraper.js");
  const db = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, { auth: { persistSession: false } });
  const status = await runJob({ db, runId: RUN_ID, scrape: runScrape, log: (m) => { console.log(m); fileLog(m); } });
  process.exit(status === "failed" ? 1 : 0);
}
</file>

