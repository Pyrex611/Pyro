/** HTTP layer (unchanged behavior from the original server.js) + optional bearer-token auth. */
import express from "express";
import { runScrape, log } from "./scraper.js";

const { PORT = 8080, MAX_CONCURRENT_SESSIONS = 5, SERVICE_TOKEN } = process.env;
const app = express();
app.use(express.json());
let activeSessions = 0;

// If SERVICE_TOKEN is set, every /scrape call must send "Authorization: Bearer <token>".
// Preferred in production: no token, and Cloud Run IAM (no allUsers invoker) instead.
const auth = (req, res, next) => {
  if (!SERVICE_TOKEN) return next();
  return req.get("authorization") === `Bearer ${SERVICE_TOKEN}` ? next() : res.status(401).json({ error: "Unauthorized" });
};

app.post("/scrape", auth, async (req, res) => {
  const { city, keyword, radius, areas } = req.body;
  if (!city || !keyword) return res.status(400).json({ error: "Missing required fields: 'city' and 'keyword' are required." });
  if (activeSessions >= Number(MAX_CONCURRENT_SESSIONS)) return res.status(429).json({ error: "Too many concurrent requests. Please try again later." });
  activeSessions++;
  log(`Starting scrape job for city="${city}" keyword="${keyword}". Active sessions: ${activeSessions}`);
  try {
    res.json(await runScrape({ city, keyword, radius, areas }));
  } catch (error) {
    log(`FATAL SCRAPE ERROR for city="${city}" keyword="${keyword}": ${error.message}`);
    res.status(500).json({ error: error.message });
  } finally {
    activeSessions--;
    log(`Finished scrape job for city="${city}" keyword="${keyword}". Active sessions: ${activeSessions}`);
  }
});

app.get("/health", (_req, res) => res.json({ ok: true }));
app.listen(PORT, () => { console.log(`Server running on http://localhost:${PORT}`); log("Server started."); });
