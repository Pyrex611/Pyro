import { z } from "zod";
import type { Adapter } from "@leads/core";
import { mapPlace } from "./map";

export { mapPlace };
const input = z.object({
  city: z.string().min(1), keyword: z.string().min(1),
  radius: z.number().int().min(100).max(50000).optional(), areas: z.array(z.string()).optional(),
});
type Input = z.infer<typeof input>;
export interface GmapsOptions { baseUrl?: string; token?: string; fetchImpl?: typeof fetch }

/** Implementation "legacy": calls the existing scraper's POST /scrape. Used for local/dev and CLI.
 *  In production the platform launches the Cloud Run Job instead (see core launchRun); the job persists itself. */
export function createGmapsLegacy(opts: GmapsOptions = {}): Adapter<Input> {
  return {
    manifest: { id: "gmaps", version: "0.2.0", role: "discovery", worker: "browser", inputSchema: input },
    // The legacy scraper does not report Places usage, so spend cannot be metered here. Rely on GCP quota caps.
    estimateCost: () => ({ units: {}, usd: 0 }),
    async *run(inp, ctx) {
      const base = opts.baseUrl ?? process.env.GMAPS_SERVICE_URL;
      if (!base) throw new Error("GMAPS_SERVICE_URL is not set");
      const token = opts.token ?? process.env.GMAPS_SERVICE_TOKEN;
      const res = await (opts.fetchImpl ?? fetch)(base.replace(/\/$/, "") + "/scrape", {
        method: "POST", signal: ctx.signal,
        headers: { "content-type": "application/json", ...(token ? { authorization: `Bearer ${token}` } : {}) },
        body: JSON.stringify(inp),
      });
      if (!res.ok) throw new Error(`scraper ${res.status}: ${(await res.text()).slice(0, 200)}`);
      const body = (await res.json()) as { results?: any[] };
      for (const p of body.results ?? []) { if (ctx.signal.aborted) return; if (p?.place_id) yield mapPlace(p, inp.keyword); }
    },
  };
}
export const gmapsLegacy = createGmapsLegacy();
