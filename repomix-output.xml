<file path="apps/web/app/runs/[id]/run-detail-client.tsx">
"use client";
import { useEffect, useState } from "react";
import { StatusBadge } from "@/components/badge";
import { relativeTime, money } from "@/lib/format";

interface RunRow { id: string; source: string; status: string; records: number; spend: Record<string, number>; error?: string | null; input: any; createdAt: string; startedAt?: string | null; finishedAt?: string | null; }
interface Rec { source: string; sourceId: string; name?: string; phone?: string; website?: string; address?: string; signals: { type: string; value: unknown }[] }

export function RunDetailClient({ id }: { id: string }) {
  const [run, setRun] = useState<RunRow | null>(null);
  const [records, setRecords] = useState<Rec[]>([]);
  const [notFound, setNotFound] = useState(false);

  const load = async () => {
    const res = await fetch(`/api/runs/${id}`, { cache: "no-store" });
    if (res.status === 404) { setNotFound(true); return; }
    const data = await res.json();
    setRun(data.run);
    const recRes = await fetch(`/api/runs/${id}/records?limit=100`, { cache: "no-store" });
    const recData = await recRes.json();
    setRecords(recData.records ?? []);
  };
  useEffect(() => { load(); }, [id]);
  useEffect(() => {
    if (!run || run.status === "succeeded" || run.status === "failed" || run.status === "canceled") return;
    const t = setInterval(load, 2000);
    return () => clearInterval(t);
  }, [run?.status]);

  async function cancel() {
    await fetch(`/api/runs/${id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "cancel" }) });
    load();
  }

  if (notFound) return <p className="text-sm" style={{ color: "var(--danger)" }}>Run not found.</p>;
  if (!run) return <p className="text-sm" style={{ color: "var(--muted)" }}>Loading…</p>;

  return (
    <div className="space-y-4">
      <div className="card">
        <div className="flex items-center justify-between">
          <div>
            <b>{run.source}</b> <span className="text-xs" style={{ color: "var(--muted)" }}>{run.id}</span>
          </div>
          <StatusBadge status={run.status} />
        </div>
        <div className="grid grid-cols-4 gap-3 mt-3">
          <div className="card"><div className="kpi-label">Records</div><div className="kpi-value">{run.records}</div></div>
          <div className="card"><div className="kpi-label">Spend</div><div className="kpi-value">{money(run.spend)}</div></div>
          <div className="card"><div className="kpi-label">Started</div><div className="text-sm mt-1">{relativeTime(run.startedAt)}</div></div>
          <div className="card"><div className="kpi-label">Finished</div><div className="text-sm mt-1">{relativeTime(run.finishedAt)}</div></div>
        </div>
        {run.error && <p className="text-sm mt-3" style={{ color: "var(--danger)" }}>{run.error}</p>}
        <pre className="text-xs mt-3 p-2 rounded" style={{ background: "var(--accent-bg)", overflowX: "auto" }}>{JSON.stringify(run.input, null, 2)}</pre>
        <div className="mt-3 flex gap-3 items-center">
          {(run.status === "queued" || run.status === "running") && <button className="btn-outline" onClick={cancel}>Cancel</button>}
          {run.status === "succeeded" && (
            <>
              <a className="btn-outline" href={`/api/runs/${run.id}/records?format=csv`}>Download CSV</a>
              <a className="btn-outline" href={`/api/runs/${run.id}/records?format=jsonl`}>Download JSONL</a>
            </>
          )}
        </div>
      </div>

      <div className="card">
        <b className="text-sm">Output (first {records.length})</b>
        {records.length === 0 ? (
          <p className="text-sm mt-2" style={{ color: "var(--muted)" }}>No records yet.</p>
        ) : (
          <table className="data mt-2">
            <thead><tr><th>Name</th><th>Phone</th><th>Website</th><th>Address</th><th>Signals</th></tr></thead>
            <tbody>
              {records.map((r) => (
                <tr key={r.sourceId}>
                  <td>{r.name ?? "—"}</td><td>{r.phone ?? "—"}</td><td>{r.website ?? "—"}</td><td>{r.address ?? "—"}</td>
                  <td>{r.signals.map((s) => s.type).join(", ") || "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  );
}
