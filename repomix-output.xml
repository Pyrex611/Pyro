import { NextRequest, NextResponse } from "next/server";
import { getStore } from "@/lib/store";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

export async function GET(_req: NextRequest, { params }: { params: { id: string } }) {
  const run = await getStore().getRun(params.id);
  if (!run) return NextResponse.json({ error: "not found" }, { status: 404 });
  return NextResponse.json({ run });
}

export async function PATCH(req: NextRequest, { params }: { params: { id: string } }) {
  const body = await req.json().catch(() => ({}));
  if (body?.action !== "cancel") return NextResponse.json({ error: "unsupported action" }, { status: 400 });
  const store = getStore();
  const run = await store.getRun(params.id);
  if (!run) return NextResponse.json({ error: "not found" }, { status: 404 });
  await store.requestCancel(params.id);
  return NextResponse.json({ ok: true });
}
</file>

<file path="apps/web/app/api/runs/route.ts">
import { NextRequest, NextResponse } from "next/server";
import { z } from "zod";
import { getStore } from "@/lib/store";
import { startGmapsRun } from "@/lib/runner";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

const Body = z.object({
  source: z.literal("gmaps"),
  input: z.object({
    city: z.string().min(1), keyword: z.string().min(1),
    radius: z.number().int().min(100).max(50000).optional(),
    areas: z.array(z.string().min(1)).optional(),
  }),
});

export async function GET(req: NextRequest) {
  const store = getStore();
  const source = req.nextUrl.searchParams.get("source");
  const runs = await store.listRuns(100);
  return NextResponse.json({ runs: source ? runs.filter((r) => r.source === source) : runs, backend: store.backend });
}

export async function POST(req: NextRequest) {
  const body = await req.json().catch(() => null);
  const parsed = Body.safeParse(body);
  if (!parsed.success) return NextResponse.json({ error: "Invalid input", issues: parsed.error.issues }, { status: 400 });
  const run = await startGmapsRun(parsed.data.input);
  return NextResponse.json({ run }, { status: 201 });
}
</file>

