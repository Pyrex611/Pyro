import { z } from "zod";
import type { Adapter, SourceRecordInput } from "@leads/core";

const input = z.object({ count: z.number().int().min(1).max(1000).default(5), dupEvery: z.number().int().min(2).default(3) });
type Input = z.infer<typeof input>;
const pad = (n: number) => String(n).padStart(2, "0");

/** Reference adapter: deterministic synthetic records (with deliberate duplicates). Copy this when starting a new source. */
export const echo: Adapter<Input> = {
  manifest: { id: "echo", version: "0.1.0", role: "discovery", worker: "light", inputSchema: input },
  estimateCost: () => ({ units: {}, usd: 0 }),
  async *run(inp, ctx) {
    for (let i = 0; i < inp.count; i++) {
      if (ctx.signal.aborted) return;
      const dup = i > 0 && i % inp.dupEvery === 0;
      const base = i - (dup ? 1 : 0);
      const rec: SourceRecordInput = {
        source: "echo", sourceId: `echo-${i}`, payload: { i },
        name: `Echo Practice ${i}`,
        phone: dup ? `614.555.01${pad(base)}` : `+1 (614) 555-01${pad(i)}`,
        website: `https://www.echo-${i}.example.com/`,
        address: `${100 + i} Main Street, Columbus, OH`,
        niche: ["medspa"],
      };
      yield rec;
    }
  },
};
