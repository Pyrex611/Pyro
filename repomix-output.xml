  appendRecords(runId: string, records: NormalizedRecord[]): Promise<void>;
  listRecords(runId: string, limit?: number): Promise<NormalizedRecord[]>;
  listAllRecords(limit?: number): Promise<NormalizedRecord[]>;
  requestCancel(runId: string): Promise<void>;
}
