import { randomUUID } from "node:crypto";
import { createClient, type SupabaseClient } from "@supabase/supabase-js";
import { config } from "../config";
import type { LeadStore, NormalizedRecord, RunRow, RunStatus } from "./types";

function toRow(r: any): RunRow {
  return {
    id: r.id, source: r.source, input: r.input, status: r.status as RunStatus,
    records: r.records ?? 0, spend: r.spend ?? {}, error: r.error ?? null,
    artifacts: r.artifacts ?? [], cancelRequested: Boolean(r.cancel_requested),
    createdAt: r.created_at, startedAt: r.started_at, finishedAt: r.finished_at, heartbeatAt: r.heartbeat_at,
  };
}
function fromNormalized(run_id: string, x: any): { run_id: string; source: string; source_id: string; payload: unknown; normalized: unknown } {
  return { run_id, source: x.source, source_id: x.source_id, payload: x.payload, normalized: x.normalized };
}
function toNormalized(row: any): NormalizedRecord {
  const n = row.normalized ?? {};
  return {
    source: row.source, sourceId: row.source_id, payload: row.payload ?? {},
    name: n.name, phone: n.phone, website: n.website, address: n.address, lat: n.lat, lng: n.lng,
    niche: n.niche ?? [], signals: n.signals ?? [],
  };
}

/** Matches supabase/migrations/0001_init.sql (runs, raw_records). Uses the service role key (server-only). */
export class SupabaseStore implements LeadStore {
  readonly backend = "supabase" as const;
  private db: SupabaseClient;
  constructor() { this.db = createClient(config.supabaseUrl, config.supabaseServiceRoleKey, { auth: { persistSession: false } }); }

  async createRun(row: { source: string; input: unknown }): Promise<RunRow> {
    const id = randomUUID();
    const { error } = await this.db.from("runs").insert({ id, source: row.source, input: row.input, status: "queued" });
    if (error) throw new Error(`createRun: ${error.message}`);
    return { id, source: row.source, input: row.input, status: "queued", records: 0, spend: {}, error: null, artifacts: [], cancelRequested: false, createdAt: new Date().toISOString() };
  }
  async getRun(id: string) {
    const { data, error } = await this.db.from("runs").select("*").eq("id", id).maybeSingle();
    if (error) throw new Error(`getRun: ${error.message}`);
    return data ? toRow(data) : null;
  }
  async listRuns(limit = 100) {
    const { data, error } = await this.db.from("runs").select("*").order("created_at", { ascending: false }).limit(limit);
    if (error) throw new Error(`listRuns: ${error.message}`);
    return (data ?? []).map(toRow);
  }
  async updateRun(id: string, patch: Partial<RunRow>) {
    const row: Record<string, unknown> = {};
    if (patch.status !== undefined) row.status = patch.status;
    if (patch.records !== undefined) row.records = patch.records;
    if (patch.spend !== undefined) row.spend = patch.spend;
    if (patch.error !== undefined) row.error = patch.error;
    if (patch.artifacts !== undefined) row.artifacts = patch.artifacts;
    if (patch.cancelRequested !== undefined) row.cancel_requested = patch.cancelRequested;
    if (patch.startedAt !== undefined) row.started_at = patch.startedAt;
    if (patch.finishedAt !== undefined) row.finished_at = patch.finishedAt;
    if (patch.heartbeatAt !== undefined) row.heartbeat_at = patch.heartbeatAt;
    const { error } = await this.db.from("runs").update(row).eq("id", id);
    if (error) throw new Error(`updateRun: ${error.message}`);
  }
  async appendRecords(runId: string, records: NormalizedRecord[]) {
    if (!records.length) return;
    const rows = records.map((r) => fromNormalized(runId, { source: r.source, source_id: r.sourceId, payload: r.payload, normalized: { name: r.name, phone: r.phone, website: r.website, address: r.address, lat: r.lat, lng: r.lng, niche: r.niche, signals: r.signals } }));
    const { error } = await this.db.from("raw_records").upsert(rows, { onConflict: "run_id,source,source_id" });
    if (error) throw new Error(`appendRecords: ${error.message}`);
  }
  async listRecords(runId: string, limit = 5000) {
    const { data, error } = await this.db.from("raw_records").select("*").eq("run_id", runId).limit(limit);
    if (error) throw new Error(`listRecords: ${error.message}`);
    return (data ?? []).map(toNormalized);
  }
  async listAllRecords(limit = 2000) {
    const { data, error } = await this.db.from("raw_records").select("*").order("fetched_at", { ascending: false }).limit(limit);
    if (error) throw new Error(`listAllRecords: ${error.message}`);
    return (data ?? []).map(toNormalized);
  }
  async requestCancel(id: string) {
    const { error } = await this.db.from("runs").update({ cancel_requested: true }).eq("id", id);
    if (error) throw new Error(`requestCancel: ${error.message}`);
  }
}
</file>

