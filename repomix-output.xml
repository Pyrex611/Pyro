import { readFileSync } from "node:fs";
import { randomUUID } from "node:crypto";
import { Budget, CsvSink, JsonlSink, runAdapter, type Adapter } from "@leads/core";
import { echo } from "@leads/source-echo";
import { gmapsLegacy } from "@leads/source-gmaps";

const registry: Record<string, Adapter> = { [echo.manifest.id]: echo, [gmapsLegacy.manifest.id]: gmapsLegacy };
const [cmd, source, ...rest] = process.argv.slice(2);
const flag = (n: string) => { const i = rest.indexOf("--" + n); return i >= 0 ? rest[i + 1] : undefined; };

if (cmd !== "run" || !source || !registry[source]) {
  console.error(`usage: lead run <${Object.keys(registry).join("|")}> [--input '<json>'|@file] [--out dir] [--max n]`);
  process.exit(2);
}
const raw = flag("input") ?? "{}";
const input = JSON.parse(raw.startsWith("@") ? readFileSync(raw.slice(1), "utf8") : raw);
const runId = randomUUID(), out = flag("out") ?? "./out";
const budget = new Budget(JSON.parse(process.env.BUDGET_CAPS ?? "{}"));
const summary = await runAdapter(registry[source]!, input, {
  runId, budget, maxRecords: flag("max") ? Number(flag("max")) : undefined,
  sinks: [new CsvSink(`${out}/${runId}/${source}.csv`), new JsonlSink(`${out}/${runId}/${source}.jsonl`)],
  log: (m, d) => console.error(m, d ?? ""),
});
console.log(JSON.stringify(summary, null, 2));
process.exit(summary.status === "succeeded" ? 0 : 1);
