import { NextRequest, NextResponse } from "next/server";
import { resolve } from "@leads/core";
import { getStore } from "@/lib/store";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

export async function GET(req: NextRequest) {
  const limit = Number(req.nextUrl.searchParams.get("limit") ?? 2000);
  const records = await getStore().listAllRecords(Number.isFinite(limit) ? limit : 2000);
  const entities = resolve(records.map((r) => ({ ...r, sourceId: r.sourceId })) as any);
  return NextResponse.json({ entities, recordCount: records.length });
}
