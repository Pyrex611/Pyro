-- Lead platform core schema. Single-user RLS for now; workers use the service role (bypasses RLS).
create table if not exists runs (
  id uuid primary key default gen_random_uuid(),
  source text not null, implementation text, input jsonb not null default '{}',
  status text not null default 'queued' check (status in ('queued','running','succeeded','failed','canceled')),
  records int not null default 0, spend jsonb not null default '{}', error text,
  cancel_requested boolean not null default false, artifacts jsonb not null default '[]',
  heartbeat_at timestamptz, created_at timestamptz not null default now(), started_at timestamptz, finished_at timestamptz
);
create table if not exists raw_records (
  id bigserial primary key, run_id uuid not null references runs(id) on delete cascade,
  source text not null, source_id text not null, payload jsonb not null, normalized jsonb not null default '{}',
  fetched_at timestamptz not null default now(), unique (run_id, source, source_id)
);
create index if not exists raw_records_lookup on raw_records (source, source_id);
create table if not exists entities (
  id uuid primary key default gen_random_uuid(), name text, phone_e164 text, domain text, address_norm text,
  lat double precision, lng double precision, niche text[] not null default '{}',
  created_at timestamptz not null default now(), updated_at timestamptz not null default now()
);
create index if not exists entities_phone on entities (phone_e164) where phone_e164 is not null;
create index if not exists entities_domain on entities (domain) where domain is not null;
create table if not exists entity_sources (
  entity_id uuid not null references entities(id) on delete cascade, source text not null, source_id text not null,
  primary key (source, source_id)
);
create table if not exists contacts (
  id uuid primary key default gen_random_uuid(), entity_id uuid not null references entities(id) on delete cascade,
  kind text not null check (kind in ('email','phone','social','person')), value text not null,
  verified boolean not null default false, source text, created_at timestamptz not null default now(),
  unique (entity_id, kind, value)
);
create table if not exists signals (
  id bigserial primary key, entity_id uuid not null references entities(id) on delete cascade,
  type text not null, value jsonb, source text not null, observed_at timestamptz not null default now()
);
create index if not exists signals_entity on signals (entity_id, type);
create table if not exists scores (
  entity_id uuid not null references entities(id) on delete cascade, version text not null,
  score numeric not null, explanation jsonb not null default '{}', computed_at timestamptz not null default now(),
  primary key (entity_id, version)
);
create table if not exists suppression (
  kind text not null check (kind in ('email','phone','domain')), value text not null, reason text,
  created_at timestamptz not null default now(), primary key (kind, value)
);
do $$ declare t text; begin
  foreach t in array array['runs','raw_records','entities','entity_sources','contacts','signals','scores','suppression'] loop
    execute format('alter table %I enable row level security', t);
    execute format('drop policy if exists "authenticated full access" on %I', t);
    execute format('create policy "authenticated full access" on %I for all to authenticated using (true) with check (true)', t);
  end loop;
end $$;
insert into storage.buckets (id, name, public) values ('runs', 'runs', false) on conflict (id) do nothing;
