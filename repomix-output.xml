add(/export async function runJob/.test(read(join(S, "job.js")) ?? "") ? "PASS" : "FAIL", "job.js exports runJob");
const utils = read(join(S, "utils.js")) ?? "";
const miss = ["randomDelay", "generateGrid", "axiosWithRetry"].filter((n) => !new RegExp("export const " + n + "\\b").test(utils));
add(utils && !miss.length ? "PASS" : "FAIL", "utils.js exports randomDelay, generateGrid, axiosWithRetry", miss.length ? "missing: " + miss.join(", ") : "");
const sp = json(join(S, "package.json"));
const needDeps = ["express", "puppeteer", "dotenv", "axios", "@supabase/supabase-js"].filter((d) => !sp?.dependencies?.[d]);
add(sp && sp.type === "module" && !needDeps.length && sp.scripts?.job ? "PASS" : "FAIL", "scraper package.json: type=module, 5 dependencies, scripts.job", needDeps.length ? "missing deps: " + needDeps.join(", ") : "");
const df = read(join(S, "Dockerfile")) ?? "";
add(/chromium/.test(df) && /CMD/.test(df) ? "PASS" : "FAIL", "scraper Dockerfile installs chromium and has CMD");
add(/FROM node:(1[0-9])\b/.test(df) ? "WARN" : "PASS", "scraper Dockerfile uses Node 20+", /FROM node:1/.test(df) ? "Node 18 is end-of-life; use node:20-slim" : "");
add(existsSync(join(S, "package-lock.json")) ? "PASS" : "WARN", "scraper package-lock.json present", "run: cd sources\\gmaps\\scraper && npm install");

// 4. installs
add(existsSync(join(root, "node_modules")) ? "PASS" : "WARN", "root dependencies installed", "run: npm install");
add(existsSync(join(S, "node_modules")) ? "PASS" : "WARN", "scraper dependencies installed", "run: cd sources\\gmaps\\scraper && npm install");

// 5. legacy hazards
for (const f of ["deploy-scraper.bat", "DOCKER~1", "DOCKER~2"]) if (existsSync(join(root, f)) || existsSync(join(S, f))) add("WARN", "legacy file present: " + f, "do NOT run deploy-scraper.bat (it overwrites Dockerfile, package.json and server.js with a stub)");

// 6. secret scan (values are never printed)
const skip = new Set(["node_modules", ".git", "out"]);
const hits = [];
(function walk(d) {
  for (const n of readdirSync(d)) {
    if (skip.has(n)) continue;
    const p = join(d, n), st = statSync(p);
    if (st.isDirectory()) walk(p);
    else if (st.size < 2_000_000) {
      const t = read(p) ?? "";
      if (/AIza[0-9A-Za-z_\-]{35}/.test(t)) hits.push([p, "Google API key pattern"]);
      if (/eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}/.test(t)) hits.push([p, "JWT-like key (Supabase?)"]);
      if (/sb_secret_[A-Za-z0-9_-]{10,}/.test(t)) hits.push([p, "Supabase secret key pattern"]);
    }
  }
})(root);
const envFiles = hits.filter(([p]) => /(^|[\\/])\.env(\.|$)/.test(p) && !/\.example$/.test(p));
const bad = hits.filter((h) => !envFiles.includes(h));
add(bad.length ? "FAIL" : "PASS", "no secrets inside tracked-style files", bad.map(([p, w]) => relative(root, p) + " (" + w + ")").join("; "));
if (envFiles.length) add("WARN", ".env file holds a secret (fine only if gitignored)", envFiles.map(([p]) => relative(root, p)).join("; "));

// 7. git
if (sh("git rev-parse --is-inside-work-tree") === "true") {
  add("PASS", "inside a git repository", "remote: " + (sh("git remote get-url origin") ?? "none"));
  const tracked = (sh("git ls-files") ?? "").split(/\r?\n/).filter((f) => /(^|\/)\.env($|\.)/.test(f) && !/\.example$/.test(f) || /(^|\/)server\.log$/.test(f) || /scripts\/env\.cmd$/.test(f));
  add(tracked.length ? "FAIL" : "PASS", "no .env / server.log / scripts\\env.cmd tracked by git", tracked.join(", "));
  add("INFO", "uncommitted changes", (sh("git status --porcelain") ?? "").split("\n").filter(Boolean).length + " file(s)");
} else add("WARN", "not inside a git repository", "run: git init");

const icon = { PASS: "[PASS]", WARN: "[WARN]", FAIL: "[FAIL]", INFO: "[INFO]" };
for (const r of out) console.log(`${icon[r.level]} ${r.name}${r.detail ? "  -> " + r.detail : ""}`);
const c = (l) => out.filter((r) => r.level === l).length;
console.log(`\nSummary: ${c("PASS")} pass, ${c("WARN")} warn, ${c("FAIL")} fail`);
process.exit(c("FAIL") ? 1 : 0);
