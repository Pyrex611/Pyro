<file path="packages/core/src/resolver.ts">
import { createHash } from "node:crypto";
import { GENERIC_DOMAINS, normalizeAddress, normalizeDomain, normalizePhone } from "./normalize";
import type { SourceRecord } from "./types";

export interface Entity {
  id: string; name?: string; phone?: string; domain?: string; address?: string;
  lat?: number; lng?: number; niche: string[];
  members: { source: string; sourceId: string }[];
  signals: SourceRecord["signals"];
}
function keys(r: SourceRecord): string[] {
  const out: string[] = [];
  const p = normalizePhone(r.phone); if (p) out.push("p:" + p);
  const d = normalizeDomain(r.website); if (d && !GENERIC_DOMAINS.has(d)) out.push("d:" + d);
  const a = normalizeAddress(r.address); if (a) out.push("a:" + a);
  return out;
}
/** Resolver v0: union records sharing a phone, a non-generic domain, or a normalized address.
 *  Known limits (tightened in Phase 3): shared call-center phones can over-merge; no fuzzy name matching. */
export function resolve(records: SourceRecord[]): Entity[] {
  const parent = records.map((_, i) => i);
  const find = (x: number): number => { while (parent[x] !== x) { parent[x] = parent[parent[x]!]!; x = parent[x]!; } return x; };
  const seen = new Map<string, number>();
  records.forEach((r, i) => {
    for (const k of keys(r)) {
      const j = seen.get(k);
      if (j === undefined) seen.set(k, i);
      else { const a = find(i), b = find(j); if (a !== b) parent[Math.max(a, b)] = Math.min(a, b); }
    }
  });
  const groups = new Map<number, SourceRecord[]>();
  records.forEach((r, i) => { const g = find(i); (groups.get(g) ?? groups.set(g, []).get(g)!).push(r); });
  return [...groups.values()].map((rs) => {
    const first = <T,>(f: (r: SourceRecord) => T | undefined) => rs.map(f).find((v) => v !== undefined && v !== "");
    const members = rs.map((r) => ({ source: r.source, sourceId: r.sourceId }));
    const id = createHash("sha1").update(members.map((m) => `${m.source}:${m.sourceId}`).sort()[0]!).digest("hex").slice(0, 16);
    return {
      id, name: first((r) => r.name),
      phone: first((r) => normalizePhone(r.phone)), domain: first((r) => { const d = normalizeDomain(r.website); return d && !GENERIC_DOMAINS.has(d) ? d : undefined; }),
      address: first((r) => normalizeAddress(r.address)), lat: first((r) => r.lat), lng: first((r) => r.lng),
      niche: [...new Set(rs.flatMap((r) => r.niche))], members, signals: rs.flatMap((r) => r.signals),
    };
  });
}
</file>

<file path="packages/core/src/runner.ts">
import { Budget, BudgetExceeded } from "./budget";
import type { RunStore } from "./store";
import type { Sink } from "./sinks";
import { SourceRecordSchema, type Adapter, type SourceRecord } from "./types";

export interface RunOptions {
  runId: string; budget?: Budget; sinks?: Sink[]; store?: RunStore; signal?: AbortSignal;
  batchSize?: number; maxRecords?: number; log?: (msg: string, data?: unknown) => void;
}
export interface RunSummary {
  runId: string; source: string; status: "succeeded" | "failed" | "canceled";
  records: number; invalid: number; spend: Record<string, number>; error?: string; durationMs: number;
}

export async function runAdapter(adapter: Adapter, rawInput: unknown, opts: RunOptions): Promise<RunSummary> {
  const t0 = Date.now();
  const { runId, sinks = [], store } = opts;
  const budget = opts.budget ?? new Budget({}, true);
  const log = opts.log ?? (() => {});
  const source = adapter.manifest.id;
  const ac = new AbortController();
  opts.signal?.addEventListener("abort", () => ac.abort());
  let records = 0, invalid = 0, buf: SourceRecord[] = [];
  let status: RunSummary["status"] = "succeeded", error: string | undefined;

  const flush = async () => {
    if (buf.length) { const b = buf; buf = []; for (const s of sinks) await s.write(b, { runId }); }
    await store?.progress(runId, { records, spend: budget.snapshot() });
    if (await store?.isCancelRequested(runId)) ac.abort();
  };
  try {
    const input = adapter.manifest.inputSchema.parse(rawInput);
    await store?.start(runId, source, input);
    const est = adapter.estimateCost(input);
    if (!budget.canAfford(est.units)) {
      const [k, n] = Object.entries(est.units).find(([k, n]) => n > budget.remaining(k))!;
      throw new BudgetExceeded(k, n, budget.remaining(k));
    }
    for (const [k, n] of Object.entries(est.units)) budget.spend(k, n);
    const it = adapter.run(input, { runId, signal: ac.signal, budget, log })[Symbol.asyncIterator]();
    for (;;) {
      if (ac.signal.aborted) { status = "canceled"; await it.return?.(); break; }
      const next = await it.next();
      if (next.done) break;
      const parsed = SourceRecordSchema.safeParse(next.value);
      if (!parsed.success) { invalid++; if (invalid <= 3) log("invalid record", parsed.error.issues); continue; }
      buf.push(parsed.data); records++;
      if (buf.length >= (opts.batchSize ?? 100)) await flush();
      if (opts.maxRecords && records >= opts.maxRecords) { await it.return?.(); break; }
    }
  } catch (e) {
    status = "failed"; error = e instanceof Error ? e.message : String(e);
  }
  try { await flush(); } catch (e) { if (status === "succeeded") { status = "failed"; error = e instanceof Error ? e.message : String(e); } }
  for (const s of sinks) await s.close().catch(() => {});
  const summary: RunSummary = { runId, source, status, records, invalid, spend: budget.snapshot(), error, durationMs: Date.now() - t0 };
  await store?.finish(summary).catch(() => {});
  return summary;
}
</file>

<file path="packages/core/src/sinks.ts">
import { appendFile, mkdir, writeFile } from "node:fs/promises";
import { dirname } from "node:path";
import type { SourceRecord } from "./types";

export interface Sink { write(records: SourceRecord[], ctx: { runId: string }): Promise<void>; close(): Promise<void> }

/** Fixed CSV contract: columns never change order or name. New fields go to JSONL/Postgres, not here. */
export const CSV_HEADER = ["source", "source_id", "name", "phone", "website", "address", "lat", "lng", "niche"] as const;
const esc = (v: unknown) => { const s = v === undefined || v === null ? "" : String(v); return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; };
export const toCsvRow = (r: SourceRecord) =>
  [r.source, r.sourceId, r.name, r.phone, r.website, r.address, r.lat, r.lng, r.niche.join("|")].map(esc).join(",");

export class CsvSink implements Sink {
  private started = false;
  constructor(private path: string) {}
  async write(records: SourceRecord[]) {
    if (!this.started) { await mkdir(dirname(this.path), { recursive: true }); await writeFile(this.path, CSV_HEADER.join(",") + "\n"); this.started = true; }
    if (records.length) await appendFile(this.path, records.map(toCsvRow).join("\n") + "\n");
  }
  async close() { if (!this.started) await this.write([]); }
}
export class JsonlSink implements Sink {
  private started = false;
  constructor(private path: string) {}
  async write(records: SourceRecord[]) {
    if (!this.started) { await mkdir(dirname(this.path), { recursive: true }); await writeFile(this.path, ""); this.started = true; }
    if (records.length) await appendFile(this.path, records.map((r) => JSON.stringify(r)).join("\n") + "\n");
  }
  async close() { if (!this.started) await this.write([]); }
}
export class MemorySink implements Sink {
  records: SourceRecord[] = [];
  async write(r: SourceRecord[]) { this.records.push(...r); }
  async close() {}
}
</file>

<file path="packages/core/src/store.ts">
import type { RunSummary } from "./runner";
import type { Sink } from "./sinks";
import type { SourceRecord } from "./types";

export interface RunStore {
  start(runId: string, source: string, input: unknown): Promise<void>;
  progress(runId: string, p: { records: number; spend: Record<string, number> }): Promise<void>;
  finish(s: RunSummary): Promise<void>;
  isCancelRequested(runId: string): Promise<boolean>;
}
export class MemoryRunStore implements RunStore {
  events: string[] = []; cancel = false; last?: RunSummary;
  async start(id: string) { this.events.push("start:" + id); }
  async progress() { this.events.push("progress"); }
  async finish(s: RunSummary) { this.last = s; this.events.push("finish:" + s.status); }
  async isCancelRequested() { return this.cancel; }
}
/** Minimal structural type so core has no hard dependency on supabase-js. */
export interface SupabaseLike { from(table: string): any }
const check = (r: { error: { message: string } | null }) => { if (r.error) throw new Error(r.error.message); };

export class SupabaseRunStore implements RunStore {
  constructor(private db: SupabaseLike) {}
  async start(id: string, source: string, input: unknown) {
    check(await this.db.from("runs").upsert({ id, source, input, status: "running", started_at: new Date().toISOString(), heartbeat_at: new Date().toISOString() }));
  }
  async progress(id: string, p: { records: number; spend: Record<string, number> }) {
    check(await this.db.from("runs").update({ records: p.records, spend: p.spend, heartbeat_at: new Date().toISOString() }).eq("id", id));
  }
  async finish(s: RunSummary) {
    check(await this.db.from("runs").update({ status: s.status, records: s.records, spend: s.spend, error: s.error ?? null, finished_at: new Date().toISOString() }).eq("id", s.runId));
  }
  async isCancelRequested(id: string) {
    const r = await this.db.from("runs").select("cancel_requested").eq("id", id).single();
    check(r); return Boolean(r.data?.cancel_requested);
  }
}
export class SupabaseSink implements Sink {
  constructor(private db: SupabaseLike, private chunk = 500) {}
  async write(records: SourceRecord[], ctx: { runId: string }) {
    for (let i = 0; i < records.length; i += this.chunk) {
      const rows = records.slice(i, i + this.chunk).map((r) => ({ run_id: ctx.runId, source: r.source, source_id: r.sourceId, payload: r.payload, normalized: { name: r.name, phone: r.phone, website: r.website, address: r.address, lat: r.lat, lng: r.lng, niche: r.niche, signals: r.signals } }));
      check(await this.db.from("raw_records").upsert(rows, { onConflict: "run_id,source,source_id" }));
    }
  }
  async close() {}
}
