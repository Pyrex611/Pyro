const place = { place_id: "p1", name: 'Glow, "Med" Spa', formatted_address: "1 Main St", international_phone_number: "+1 614-555-0101", rating: 4.8, user_ratings_total: 120, geometry: { location: { lat: 1, lng: 2 } }, fallback_data: { emails: ["a@b.com"] } };

function fakeDb({ cancel = false, uploadError = null, upsertError = null } = {}) {
  const s = { updates: [], uploads: [], upserts: [], run: { input: { city: "Columbus, OH", keyword: "med spa" }, status: "queued", cancel_requested: cancel } };
  return { s, storage: { from: () => ({ upload: async (p, b) => { s.uploads.push(p); return { error: uploadError }; } }) },
    from: (t) => ({
      select: () => ({ eq: () => ({ single: async () => ({ data: s.run, error: null }) }) }),
      update: (v) => ({ eq: async () => { s.updates.push(v); return { error: null }; } }),
      upsert: async (rows) => { s.upserts.push(...rows); return { error: upsertError }; },
    }) };
}
const last = (db) => db.s.updates.at(-1);

describe("persist mapping", () => {
  it("maps a place and keeps signals", () => {
    const r = mapPlace(place, "med spa");
    expect(r.sourceId).toBe("p1"); expect(r.signals.map((x) => x.type)).toEqual(["rating", "review_count", "no_website", "emails"]);
  });
  it("csv escapes quotes and commas", () => { expect(toCsv([mapPlace(place, "med spa")])).toContain('"Glow, ""Med"" Spa"'); });
});
describe("runJob", () => {
  it("scrapes, uploads 3 artifacts, upserts rows, marks succeeded", async () => {
    const db = fakeDb();
    const status = await runJob({ db, runId: "r1", pollMs: 1e6, scrape: async () => ({ results: [place] }), log: () => {} });
    expect(status).toBe("succeeded");
    expect(db.s.uploads).toEqual(["r1/gmaps.csv", "r1/gmaps.jsonl", "r1/gmaps.raw.json"]);
    expect(db.s.upserts[0]).toMatchObject({ run_id: "r1", source: "gmaps", source_id: "p1" });
    expect(last(db)).toMatchObject({ status: "succeeded", records: 1 });
  });
  it("marks failed when the scraper throws", async () => {
    const db = fakeDb();
    expect(await runJob({ db, runId: "r", pollMs: 1e6, scrape: async () => { throw new Error("geocode failed"); }, log: () => {} })).toBe("failed");
    expect(last(db)).toMatchObject({ status: "failed", error: "geocode failed" });
  });
  it("keeps already-uploaded artifacts when the DB write fails", async () => {
    const db = fakeDb({ upsertError: { message: "db down" } });
    expect(await runJob({ db, runId: "r", pollMs: 1e6, scrape: async () => ({ results: [place] }), log: () => {} })).toBe("failed");
    expect(last(db).artifacts).toHaveLength(3);
  });
  it("cancels while the scrape is still running", async () => {
    const db = fakeDb({ cancel: true });
    expect(await runJob({ db, runId: "r", pollMs: 5, scrape: () => new Promise(() => {}), log: () => {} })).toBe("canceled");
    expect(last(db).status).toBe("canceled");
  });
});
