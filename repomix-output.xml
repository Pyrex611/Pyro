export function normalizePhone(raw?: string): string | undefined {
  if (!raw) return undefined;
  const d = raw.replace(/\D/g, "");
  if (d.length === 10) return "+1" + d;
  if (d.length === 11 && d.startsWith("1")) return "+" + d;
  if (d.length >= 11 && raw.trim().startsWith("+")) return "+" + d;
  return undefined;
}
export function normalizeDomain(raw?: string): string | undefined {
  if (!raw) return undefined;
  try {
    const u = new URL(/^https?:\/\//i.test(raw) ? raw : "https://" + raw);
    const h = u.hostname.toLowerCase().replace(/^www\./, "");
    return h.includes(".") ? h : undefined;
  } catch { return undefined; }
}
const ABBR: [RegExp, string][] = [
  [/\bstreet\b/g, "st"], [/\bavenue\b/g, "ave"], [/\broad\b/g, "rd"], [/\bboulevard\b/g, "blvd"],
  [/\bdrive\b/g, "dr"], [/\bsuite\b/g, "ste"], [/\bnorth\b/g, "n"], [/\bsouth\b/g, "s"],
  [/\beast\b/g, "e"], [/\bwest\b/g, "w"], [/\bunited states\b|\busa\b/g, ""],
];
export function normalizeAddress(raw?: string): string | undefined {
  if (!raw) return undefined;
  let s = raw.toLowerCase().replace(/[.,#]/g, " ");
  for (const [re, rep] of ABBR) s = s.replace(re, rep);
  s = s.replace(/\s+/g, " ").trim();
  return s || undefined;
}
/** Shared platforms: never use these domains to link two records into one entity. */
export const GENERIC_DOMAINS = new Set([
  "facebook.com", "instagram.com", "linktr.ee", "yelp.com", "vagaro.com", "square.site",
  "wixsite.com", "squarespace.com", "google.com", "linkedin.com", "tiktok.com",
]);
