import { z } from "zod";
import type { Budget } from "./budget";

export const Signal = z.object({ type: z.string(), value: z.unknown(), observedAt: z.string().optional() });

export const SourceRecordSchema = z.object({
  source: z.string().min(1),
  sourceId: z.string().min(1),
  payload: z.record(z.string(), z.unknown()),
  name: z.string().optional(),
  phone: z.string().optional(),
  website: z.string().optional(),
  address: z.string().optional(),
  lat: z.number().optional(),
  lng: z.number().optional(),
  niche: z.array(z.string()).default([]),
  signals: z.array(Signal).default([]),
});
export type SourceRecord = z.output<typeof SourceRecordSchema>;
export type SourceRecordInput = z.input<typeof SourceRecordSchema>;

export interface Manifest {
  id: string; // kebab-case, equals SourceRecord.source
  version: string;
  role: "discovery" | "enrichment";
  worker: "light" | "browser";
  inputSchema: z.ZodTypeAny;
}
export interface CostEstimate { units: Record<string, number>; usd: number }
export interface RunContext {
  runId: string;
  signal: AbortSignal;
  budget: Budget;
  log: (msg: string, data?: unknown) => void;
}
export interface Adapter<I = any> {
  manifest: Manifest;
  estimateCost(input: I): CostEstimate;
  run(input: I, ctx: RunContext): AsyncIterable<SourceRecordInput>;
}
