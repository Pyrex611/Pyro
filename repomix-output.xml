export type RunStatus = "queued" | "running" | "succeeded" | "failed" | "canceled";

export interface RunRow {
  id: string;
  source: string;
  input: unknown;
  status: RunStatus;
  records: number;
  spend: Record<string, number>;
  error?: string | null;
  artifacts: { name: string; bytes?: number; path?: string }[];
  cancelRequested: boolean;
  createdAt: string;
  startedAt?: string | null;
  finishedAt?: string | null;
  heartbeatAt?: string | null;
}

export interface Signal { type: string; value: unknown }

export interface NormalizedRecord {
  source: string;
  sourceId: string;
  payload: Record<string, unknown>;
  name?: string;
  phone?: string;
  website?: string;
  address?: string;
  lat?: number;
  lng?: number;
