<file path="sources/gmaps/src/map.ts">
import type { SourceRecordInput } from "@leads/core";

/** Mirrors scraper/persist.js mapPlace (a parity test keeps them identical). */
export function mapPlace(p: any, keyword?: string): SourceRecordInput {
  const loc = p?.geometry?.location ?? {};
  const fb = p?.fallback_data ?? {};
  const signals: { type: string; value: unknown }[] = [];
  if (p.rating != null) signals.push({ type: "rating", value: p.rating });
  if (p.user_ratings_total != null) signals.push({ type: "review_count", value: p.user_ratings_total });
  if (p.business_status) signals.push({ type: "business_status", value: p.business_status });
  if (!p.website) signals.push({ type: "no_website", value: true });
  if (fb.emails?.length) signals.push({ type: "emails", value: fb.emails });
  if (fb.phones?.length) signals.push({ type: "site_phones", value: fb.phones });
  if (fb.social_media?.length) signals.push({ type: "social_links", value: fb.social_media });
  if (p.url) signals.push({ type: "maps_url", value: p.url });
  return {
    source: "gmaps", sourceId: p.place_id, payload: p, name: p.name, phone: p.international_phone_number,
    website: p.website, address: p.formatted_address, lat: loc.lat, lng: loc.lng,
    niche: keyword ? [keyword] : [], signals,
  };
}
